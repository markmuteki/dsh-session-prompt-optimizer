{
  "name": "dsh-session-prompt-optimizer",
  "version": "1.2.2",
  "type": "module",
  "description": "Composer button for DeepSeek Harness that rewrites the draft into a sharper prompt and shows the result beside your text before anything is replaced.",
  "license": "MIT",
  "author": "markmuteki",
  "homepage": "https://github.com/markmuteki/dsh-session-prompt-optimizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmuteki/dsh-session-prompt-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/markmuteki/dsh-session-prompt-optimizer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-optimizer",
    "composer",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "upstream.js",
    "context.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
